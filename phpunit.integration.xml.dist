<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	bootstrap="tests/integration/bootstrap.php"
	colors="true"
	verbose="true"
	failOnWarning="true"
	failOnRisky="true"
>
	<testsuites>
		<testsuite name="PressQueue integration tests">
			<directory>tests/integration</directory>
		</testsuite>
	</testsuites>
</phpunit>
